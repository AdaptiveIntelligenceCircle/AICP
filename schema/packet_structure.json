{
  "packet_format": "AICPv1",
  "magic_number": "0xA1C9F00D",
  "header": {
    "fields": [
      { "name": "magic", "type": "uint32_t", "description": "Protocol identifier." },
      { "name": "version", "type": "uint16_t", "description": "Protocol version number." },
      { "name": "header_length", "type": "uint16_t", "description": "Length of header section in bytes." },
      { "name": "payload_length", "type": "uint32_t", "description": "Length of the payload data." },
      { "name": "checksum", "type": "uint32_t", "description": "CRC32 checksum of payload section." }
    ],
    "endianness": "little",
    "compression": {
      "enabled": true,
      "algorithm": "zlib",
      "detect_magic": "AICPZLIB"
    }
  },
  "payload": {
    "encoding": "UTF-8 JSON (serialized MessageEnvelope)",
    "fields": [
      { "name": "protocol_id", "type": "string" },
      { "name": "sender_id", "type": "string" },
      { "name": "sequence", "type": "uint64_t" },
      { "name": "payload", "type": "binary (AEAD encrypted)" },
      { "name": "signature", "type": "binary (ECDSA)" }
    ]
  },
  "validation_rules": {
    "max_payload_size": "4MB",
    "checksum_required": true,
    "timestamp_sync_tolerance_ms": 2500
  }
}
